VITE_CORE_API_BASE_URL=/core-api
VITE_EDGE_API_BASE_URL=/edge-api
# Optional browser SSO adapter. The backend must validate state/code and return a Core JWT.
VITE_ADMIN_SSO_START_URL=
VITE_ADMIN_SSO_EXCHANGE_URL=
# Vite dev-server upstreams; not used as runtime credentials.
VITE_CORE_API_UPSTREAM=http://127.0.0.1:8081
VITE_EDGE_API_UPSTREAM=http://127.0.0.1:8082
VITE_ENABLE_DEV_ACTOR=false
VITE_DEV_ACTOR_ROLE=manager
VITE_DEV_ACTOR_PUBLIC_ID=dev-manager
VITE_DEV_ACTOR_TEAM_IDS=
VITE_DEV_ACTOR_AREA_IDS=
