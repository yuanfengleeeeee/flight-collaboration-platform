<view class="page-shell task-page">
  <view class="eyebrow">WECOM / HISTORY</view>
  <view class="title">历史任务</view>
  <view class="muted">这里只展示已经完成或取消的个人任务 Projection。</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{loading}}" class="card muted">正在读取历史任务…</view>
  <view wx:if="{{!loading && items.length === 0}}" class="card muted">暂无历史任务</view>
  <view wx:for="{{items}}" wx:key="public_id" class="task-card" data-id="{{item.public_id}}" bindtap="openTask">
    <view class="task-card__top"><view><view class="task-card__title">{{item.task_name}}</view><view class="task-card__flight">{{item.flight_display_no}}</view></view><view class="status">{{item.business_status || item.status}}</view></view>
    <text class="task-card__meta">{{item.area_name}} · {{item.planned_at}}</text>
    <text class="task-card__meta">{{item.message}}</text>
  </view>
  <view wx:if="{{total > 0}}" class="pagination"><button size="mini" disabled="{{loading || page <= 1}}" bindtap="previousPage">上一页</button><text>第 {{page}} 页 / 共 {{total}} 条</text><button size="mini" disabled="{{loading || page * pageSize >= total}}" bindtap="nextPage">下一页</button></view>
  <view class="bottom-nav"><navigator class="bottom-nav__item" url="/pages/tasks/index">任务</navigator><navigator class="bottom-nav__item" url="/pages/notifications/index">通知</navigator><navigator class="bottom-nav__item active" url="/pages/history/index">历史</navigator><navigator class="bottom-nav__item" url="/pages/exceptions/index">异常</navigator><navigator class="bottom-nav__item" url="/pages/account/index">账号</navigator></view>
</view>
