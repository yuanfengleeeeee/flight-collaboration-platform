<view class="page-shell task-page">
  <view class="eyebrow">WECOM / TASKS</view>
  <view class="title">我的任务</view>
  <view class="realtime-state">实时：{{realtimeState}}</view>
  <view class="muted">任务来自项目员工账号对应的 Edge Projection，企业微信只负责入口和身份绑定。</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{loading}}" class="card muted">正在同步任务…</view>
  <view wx:if="{{!loading && tasks.length === 0}}" class="card muted">当前没有可执行任务</view>
  <view wx:for="{{tasks}}" wx:key="public_id" class="task-card status-card-{{item.business_status || item.status}}" data-id="{{item.public_id}}" bindtap="openTask">
    <view class="task-card__top"><view><view class="task-card__title">{{item.task_name}}</view><view class="task-card__flight">{{item.flight_display_no}}</view></view><view class="status">{{item.status_label}}</view></view>
    <text class="task-card__meta">{{item.area_name}} · {{item.planned_at}}</text>
    <text class="task-card__meta">{{item.message}}</text>
  </view>
  <view class="bottom-nav"><navigator class="bottom-nav__item active" url="/pages/tasks/index">任务</navigator><navigator class="bottom-nav__item" url="/pages/notifications/index">通知</navigator><navigator class="bottom-nav__item" url="/pages/history/index">历史</navigator><navigator class="bottom-nav__item" url="/pages/exceptions/index">异常</navigator><navigator class="bottom-nav__item" url="/pages/account/index">账号</navigator></view>
</view>
